{
  "name": "RepoGCC | Java y PostgreSQL",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "API REST de libros"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
